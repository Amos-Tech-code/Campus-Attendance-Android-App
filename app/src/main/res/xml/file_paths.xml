<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- For internal cache -->
    <cache-path
        name="cache"
        path="." />

    <!-- For external cache -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- For external files (Downloads) -->
